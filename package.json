{
  "name": "dsh-stt-plugin",
  "version": "0.1.1",
  "description": "Speech-to-text (voice input) plugin for DeepSeek Harness — a microphone toggle in the composer tool row and a Voice Input settings page.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "tsconfig.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "schemastery": "3.18.0",
    "typescript": "^5.8.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "stt",
    "speech-to-text",
    "voice-input"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zemanzhang809/dsh-stt-plugin.git"
  },
  "homepage": "https://github.com/zemanzhang809/dsh-stt-plugin#readme",
  "bugs": {
    "url": "https://github.com/zemanzhang809/dsh-stt-plugin/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
